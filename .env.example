# SMTP credentials for the Start a Project form (server-side only).
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# Gmail SMTP host
SMTP_HOST=smtp.gmail.com

# Gmail SMTP port (465 = SSL, 587 = STARTTLS)
SMTP_PORT=465

# Your Gmail address (the account that owns the App Password)
SMTP_USER=brightynexaistudio@gmail.com

# 16-character Google App Password (no spaces).
# Generate at https://myaccount.google.com/apppasswords after enabling 2-Step Verification.
SMTP_PASS=your_16_char_app_password_here

# Email address that appears in the "From" field (usually same as SMTP_USER)
SMTP_FROM=brightynexaistudio@gmail.com

# Email address that receives the form submissions
MAIL_TO=brightynexaistudio@gmail.com

# Optional — only needed if you use Prisma. Not required for the website itself.
# DATABASE_URL=file:./db/custom.db
